# Adrenaline BOF Kit — Cobalt Strike Aggressor Script
#
# Loads every BOF in this repository into Beacon as a native command.
# Load via Cobalt Strike -> Script Manager -> Load (or team server
# aggressor autostart). Paths are resolved relative to this file, so keep
# it at the repository root.
#
# Argument packing (bof_pack format characters) was derived directly from
# each module's go() function (BeaconDataExtract/BeaconDataShort/
# BeaconDataInt calls), not guessed from the README alone:
#   z = narrow (char*) string      Z = wide (wchar_t*) string
#   s = 16-bit short                i = 32-bit int
#
# Only the x64 build is wired up here (x64 is always built; x86 is
# optional per-module). Swap ".x64.o" for ".x86.o" in bof_run() calls
# below if you need a 32-bit beacon variant that exists for that module.
#
# DISCLAIMER: offensive-security tooling for authorized engagements only.
# See the repository README for the full disclaimer.

sub bof_run {
    # $1 = bid, $2 = path to .o relative to this script, $3 = bof_pack() blob
    local('$handle $data');
    $handle = openf(script_resource($2));
    $data   = readb($handle, -1);
    closef($handle);
    btask($1, "Running BOF: " . $2);
    beacon_inline_execute($1, $data, "go", $3);
}

