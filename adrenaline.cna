# net_use add <share> <username> <password> <device> <persist 0|1> <requirePrivacy 0|1>
# net_use list [device]
# net_use delete <device> <persist 0|1> <force 0|1>
alias net_use {
    local('$sub $args');
    $sub = lower($2);

    if ($sub eq "add") {
        $args = bof_pack($1, "sZZZZss", 1, $3, $4, $5, $6, $7, $8);
    } else if ($sub eq "list") {
        if ($3 !is $null && $3 ne "") {
            $args = bof_pack($1, "sZ", 2, $3);
        } else {
            $args = bof_pack($1, "sZ", 2, "");
        }
    } else if ($sub eq "delete") {
        if ($3 is $null || $3 eq "") {
            berror($1, "Usage: net_use delete <device> <persist 0|1> <force 0|1>");
            return;
        }
        $args = bof_pack($1, "sZss", 3, $3, $4, $5);
    } else {
        berror($1, "Usage: net_use <add <share> <user> <pass> <device> <persist> <reqPrivacy> | list [device] | delete <device> <persist> <force>>");
        return;
    }

    bof_run($1, "community/net_use/net_use.x64.o", $args);
}

