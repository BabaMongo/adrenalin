# ===========================================================================
# Execution
# ===========================================================================

# com_probe <CLSID> [IID]
alias com_probe {
    if ($2 is $null || $2 eq "") {
        berror($1, "Usage: com_probe <CLSID> [IID]");
        return;
    }
    if ($3 !is $null && $3 ne "") {
        bof_run($1, "execution/com_probe/com_probe.x64.o", bof_pack($1, "zz", $2, $3));
    } else {
        bof_run($1, "execution/com_probe/com_probe.x64.o", bof_pack($1, "z", $2));
    }
}

# firewall_rule add <name> <in|out> <allow|block> <tcp|udp|any> [localport] [remoteport] [profile]
# firewall_rule remove <name>
# firewall_rule query <name>
# firewall_rule list
alias firewall_rule {
    local('$sub $lport');
    $sub = lower($2);

    if ($sub eq "list") {
        bof_run($1, "execution/firewall_rule/firewall_rule.x64.o", bof_pack($1, "z", "list"));
    } else if ($sub eq "remove" || $sub eq "query") {
        if ($3 is $null || $3 eq "") {
            berror($1, "Usage: firewall_rule " . $sub . " <name>");
            return;
        }
        bof_run($1, "execution/firewall_rule/firewall_rule.x64.o", bof_pack($1, "zz", $sub, $3));
    } else if ($sub eq "add") {
        if ($3 is $null || $3 eq "" || $4 is $null || $4 eq "" || $5 is $null || $5 eq "" || $6 is $null || $6 eq "") {
            berror($1, "Usage: firewall_rule add <name> <in|out> <allow|block> <tcp|udp|any> [localport] [remoteport] [profile]");
            return;
        }
        $lport = $7;
        if ($lport is $null) { $lport = ""; }

        if ($9 !is $null && $9 ne "") {
            bof_run($1, "execution/firewall_rule/firewall_rule.x64.o", bof_pack($1, "zzzzzzzz", $sub, $3, $4, $5, $6, $lport, $8, $9));
        } else if ($8 !is $null && $8 ne "") {
            bof_run($1, "execution/firewall_rule/firewall_rule.x64.o", bof_pack($1, "zzzzzzz", $sub, $3, $4, $5, $6, $lport, $8));
        } else {
            bof_run($1, "execution/firewall_rule/firewall_rule.x64.o", bof_pack($1, "zzzzzz", $sub, $3, $4, $5, $6, $lport));
        }
    } else {
        berror($1, "Usage: firewall_rule <add|remove|query|list> ...");
    }
}

# service_control query [service_name]
# service_control create <service_name> <bin_path> [display_name] [start_type] [service_type] [error_control]
# service_control start|stop|delete <service_name>
# service_control failure <service_name> <reset_seconds> [reboot_msg] [command] [actions]
alias service_control {
    local('$sub $path');
    $sub = lower($2);
    $path = "execution/service_control/service_control.x64.o";

    if ($sub eq "query") {
        if ($3 !is $null && $3 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZ", $sub, $3));
        } else {
            bof_run($1, $path, bof_pack($1, "Z", $sub));
        }
    } else if ($sub eq "start" || $sub eq "stop" || $sub eq "delete") {
        if ($3 is $null || $3 eq "") {
            berror($1, "Usage: service_control " . $sub . " <service_name>");
            return;
        }
        bof_run($1, $path, bof_pack($1, "ZZ", $sub, $3));
    } else if ($sub eq "create") {
        if ($3 is $null || $3 eq "" || $4 is $null || $4 eq "") {
            berror($1, "Usage: service_control create <service_name> <bin_path> [display_name] [start_type] [service_type] [error_control]");
            return;
        }
        if ($8 !is $null && $8 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZZZiii", $sub, $3, $4, $5, $6, $7, $8));
        } else if ($7 !is $null && $7 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZZZii", $sub, $3, $4, $5, $6, $7));
        } else if ($6 !is $null && $6 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZZZi", $sub, $3, $4, $5, $6));
        } else if ($5 !is $null && $5 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZZZ", $sub, $3, $4, $5));
        } else {
            bof_run($1, $path, bof_pack($1, "ZZZ", $sub, $3, $4));
        }
    } else if ($sub eq "failure") {
        if ($3 is $null || $3 eq "" || $4 is $null || $4 eq "") {
            berror($1, "Usage: service_control failure <service_name> <reset_seconds> [reboot_msg] [command] [actions]");
            return;
        }
        if ($7 !is $null && $7 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZiZZZ", $sub, $3, $4, $5, $6, $7));
        } else if ($6 !is $null && $6 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZiZZ", $sub, $3, $4, $5, $6));
        } else if ($5 !is $null && $5 ne "") {
            bof_run($1, $path, bof_pack($1, "ZZiZ", $sub, $3, $4, $5));
        } else {
            bof_run($1, $path, bof_pack($1, "ZZi", $sub, $3, $4));
        }
    } else {
        berror($1, "Usage: service_control <query|create|start|stop|delete|failure> ...");
    }
}

